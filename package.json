{
  "name": "nestfleet",
  "version": "0.1.0",
  "description": "NestFleet — AI-powered product operations platform",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file .env watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "spike:ingest": "tsx scripts/ingest-docs.ts",
    "spike:eval": "tsx tests/spike-01/run-evaluation.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.125",
    "@ai-sdk/google": "^3.0.129",
    "@ai-sdk/openai": "^3.0.120",
    "@hono/node-server": "^2.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "ai": "^6.0.296",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.5",
    "jose": "^6.2.12",
    "js-yaml": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.12",
    "pg-boss": "^12.30.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.9",
    "ssh2": "^1.17.0",
    "stripe": "^21.0.1",
    "ulid": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^4.1.11",
    "msw": "^2.15.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@grpc/grpc-js": "^1.14.4",
    "esbuild": "^0.28.1",
    "@opentelemetry/core": "^2.8.0",
    "undici": "^8.5.0",
    "protobufjs": "^7.6.5",
    "brace-expansion": "^2.1.2",
    "@opentelemetry/propagator-jaeger": "^2.9.0"
  },
  "notes": {
    "otel-audit": "GHSA-q7rr-3cgh-j5r3 (Prometheus exporter crash) affects @opentelemetry/sdk-node <=0.216.0. NestFleet does not start a Prometheus metrics endpoint so this path is not reachable. Fix requires OTel ecosystem upgrade 0.57→0.217 (breaks @opentelemetry/core peer deps). Track in v0.2.0 backlog."
  }
}
